# vim: ft=gitconfig

[color]
	diff = auto
	status = auto
	branch = auto
	interactive = auto
	ui = true
	pager = true

[user]
	email = git@zesmoi.com.br
	name = Moizes Sousa
	signingkey = 4BF5E8D6DC95603D675F328761BCED4163773EE2

[commit]
	gpgsign = true

[init]
	defaultBranch = develop 

[branch "autosetup"]
	rebase = yes

[core]
	askpass = 
	editor = nvim

[credential]
	credentialStore = plaintext 
	oauthAuthenticationModes = browser,devicecode
	helper = /usr/local/bin/git-credential-manager

[alias]
	commits = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(r) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	root = rev-parse --show-toplevel

[push]
	gpgSign = false
	default = tracking
	autoSetupRemote = true

[pull]
	ff = true

[credential "helperselector"]
	selected = manager
[rerere]
	enabled = true
[gpg]
	program = gpg 
[credential "https://dev.azure.com"]
	useHttpPath = true
[credential "https://git.grupomidas.com.br"]
	provider = generic
